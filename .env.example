# UBPM environment variables — copy to .env and fill in.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Dev default: SQLite. For Postgres, use docker-compose and set:
# DATABASE_URL=postgres://ubpm:ubpm@localhost:5432/ubpm
DATABASE_URL=sqlite:///db.sqlite3

# --- Email (prod) ---
DEFAULT_FROM_EMAIL=UBPM <noreply@ubpm.mn>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Dev toggles ---
ENABLE_DEBUG_TOOLBAR=False
