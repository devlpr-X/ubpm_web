# UBPM environment variables — copy to .env and fill in.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Dev default: SQLite. For Postgres, use docker-compose and set:
# DATABASE_URL=postgres://ubpm:ubpm@localhost:5432/ubpm
DATABASE_URL=sqlite:///db.sqlite3

# --- Email (prod) ---
DEFAULT_FROM_EMAIL=UBPM <noreply@ubpm.mn>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# 587 порт hosting талаас хаалттай бол: EMAIL_PORT=465 + EMAIL_USE_SSL=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# Gmail: энгийн нууц үг биш, App Password (Google Account → Security →
# 2-Step Verification → App passwords). Зайг нь автоматаар цэвэрлэдэг.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Admin (default superuser created by `manage.py ensure_admin`) ---
# Login at /admin/ with username "admin" and this password.
ADMIN_ALIAS_EMAIL=admin@ubpm.mn
# (password is passed to ensure_admin; default 1234)

# --- Object storage / CDN (optional). Cloudflare R2 (S3-compatible). Storage
#     turns on automatically when R2_BUCKET is set. Leave blank for local media.
#     (Generic AWS_* names are also accepted for other S3 providers.) ---
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_URL=

# --- Google Sign-In (mobile app, optional) ---
GOOGLE_OAUTH2_KEY=
GOOGLE_OAUTH2_SECRET=

# --- Railway / prod toggles ---
# Prod default: ubpm.mn is the primary domain (ALLOWED_HOSTS, CSRF, SITE_URL
# defaults already cover it). RAILWAY_PUBLIC_DOMAIN is injected by Railway
# automatically and trusted as a fallback.
# ALLOWED_HOSTS=ubpm.mn,www.ubpm.mn
# SITE_URL=https://ubpm.mn
# CSRF_TRUSTED_ORIGINS=https://ubpm.mn,https://www.ubpm.mn
# SECURE_SSL_REDIRECT=True

# --- Dev toggles ---
ENABLE_DEBUG_TOOLBAR=False
