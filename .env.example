# UBPM environment variables — copy to .env and fill in.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Dev default: SQLite. For Postgres, use docker-compose and set:
# DATABASE_URL=postgres://ubpm:ubpm@localhost:5432/ubpm
DATABASE_URL=sqlite:///db.sqlite3

# --- Email (prod) ---
DEFAULT_FROM_EMAIL=UBPM <noreply@ubpm.mn>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Admin (default superuser created by `manage.py ensure_admin`) ---
# Login at /admin/ with username "admin" and this password.
ADMIN_ALIAS_EMAIL=admin@ubpm.mn
# (password is passed to ensure_admin; default 1234)

# --- Object storage / CDN (optional, S3-compatible: AWS S3, Cloudflare R2,
#     Bunny, DigitalOcean Spaces, MinIO). Leave USE_S3=False for local media. ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# --- Railway / prod toggles ---
# RAILWAY_PUBLIC_DOMAIN is injected by Railway automatically.
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
# SECURE_SSL_REDIRECT=True

# --- Dev toggles ---
ENABLE_DEBUG_TOOLBAR=False
